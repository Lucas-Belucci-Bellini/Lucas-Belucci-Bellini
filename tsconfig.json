{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "rootDir": "frontend",
    "outDir": "frontend/build",
    "skipLibCheck": true
  },
  "include": ["frontend/contracts.ts", "frontend/main.ts"]
}
